# Copy this file to .env and fill in your real key:
#   Windows (cmd):        copy .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
#
# Never commit the real .env file.

# Required. Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Optional overrides -----------------------------------------
# Leave blank to use the safe defaults defined in src/config.py.

# Gemini chat model. Default: gemini-3.5-flash-lite (fast, cost-effective,
# current stable model as of Sept 2026). Use gemini-3.8-flash for higher
# quality at higher cost.
GEMINI_MODEL=gemini-3.5-flash-lite

# Gemini embedding model used to vectorize PDF chunks and questions.
EMBEDDING_MODEL=models/gemini-embedding-001

# LLM sampling temperature (0.0 = deterministic, 1.0 = creative).
TEMPERATURE=0.2

# Chunking (characters).
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Number of chunks retrieved per question.
TOP_K=4
